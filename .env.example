# Kopieren nach .env.local (wird nicht committet) und ausfüllen.
# Diese Werte landen im Client-Bundle — sie sind öffentlich. Deshalb niemals
# Passwörter oder API-Keys hier eintragen.

# Kartenstil (optional). Standard: OpenFreeMap Liberty
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Betreiberangaben für Impressum und Datenschutzerklärung (§ 5 DDG)
VITE_LEGAL_NAME=Vorname Nachname
VITE_LEGAL_STREET=Straße Hausnummer
VITE_LEGAL_POSTAL_CODE=12345
VITE_LEGAL_CITY=Ort
VITE_LEGAL_COUNTRY=Deutschland
VITE_LEGAL_EMAIL=kontakt@example.de
# optional
VITE_LEGAL_PHONE=
VITE_LEGAL_AUTHORITY=Landesbeauftragte für Datenschutz und Informationsfreiheit …
VITE_LEGAL_UPDATED=17. Oktober 2026
